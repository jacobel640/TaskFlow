<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Only the tasks database and the settings are backed up - shared preferences (where
   Firebase keeps its sign in state) are left out so a stale session is never restored.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tasks_db" />
        <include domain="database" path="tasks_db-wal" />
        <include domain="database" path="tasks_db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tasks_db" />
        <include domain="database" path="tasks_db-wal" />
        <include domain="database" path="tasks_db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
